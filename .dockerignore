# в образ nginx попадает только статика; серверы аукциона, рулетки, бомбы и «Вопроса ребром» собираются из своих Dockerfile
.git
.github
.env
auction/
# рулетка: соло грузит движок как статику; сервер, боты и тесты — нет
roulette/*
!roulette/game.js
bomb/
fibs/
quip/
wave/
crowd/
oneword/
ifeel/
# блэкджек: соло и телефон грузят движок и базовую стратегию как статику; сервер, боты и тесты — нет
blackjack/*
!blackjack/game.js
!blackjack/strategy.js
# «Последний вопрос»: сервер, тесты и банк с ответами — не статика; лаборатория испытаний — только локально
lastq/
lastq-lab.html
roulette-wheel-lab.html
# блэкджек: стенд стола — только локально
blackjack-lab.html
# клиенту нужны движок (льдина по seed, предсказание) и боты витрины; сервер и тесты — нет
floe/*
!floe/game.js
!floe/bots.js
floe-lab.html
# то же для «Утиного сплава»
rapids/*
!rapids/game.js
!rapids/bots.js
# «Кувшинки»: клиенту нужны формулы, модель мира, движок (витрина, тренировка) и боты; сервер и тесты — нет
pond/*
!pond/physics.js
!pond/model.js
!pond/game.js
!pond/bots.js
storm/
# «Ставки»: сервер, движок, тесты и состояние — не статика (клиентам нужен только bets-shared.js в корне); лаборатории — только локально
bets/
bets-lab-*
# общий серверный код игр (lib/codes.js, lib/net.js) — не статика
lib/
*.md
.DS_Store
# спеки игр — не статика
docs/
# стенды и тест-инструменты — не статика сайта (T-W0-03)
tools/
